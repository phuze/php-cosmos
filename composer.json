{
  "name"       : "phuze/php-cosmos",
  "description": "A PHP client for Azure Cosmos DB",
  "keywords"   : ["azure", "cosmos", "cosmosdb", "cosmos-db", "nosql", "sql", "rest", "api", "php"],
  "homepage"   : "https://github.com/phuze/php-cosmos",
  "license"    : "MIT",
  "support": {
    "source": "https://github.com/phuze/php-cosmos",
    "issues": "https://github.com/phuze/php-cosmos/issues"
  },
  "require"    :{
    "php": ">=7.0",
    "ext-curl": "*",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^6.0 || ^7.0 || ^8.0",
    "psr/log": "^1.0 || ^2.0 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "Phuze\\PhpCosmos\\": "src/"
    }
  },
  "scripts": {
    "test": "@php tests/run.php"
  },
  "scripts-descriptions": {
    "test": "Run the test suite"
  }
}
